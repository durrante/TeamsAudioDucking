<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TeamsAudioDucking</RootNamespace>
    <AssemblyName>TeamsAudioDucking</AssemblyName>
    <Version>1.4.2</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Teams Audio Ducking</Product>
    <AssemblyTitle>Teams Audio Ducking</AssemblyTitle>
    <Description>Mutes other applications' audio during Microsoft Teams calls and restores it afterwards.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
